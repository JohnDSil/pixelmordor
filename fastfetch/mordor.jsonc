{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "baraddur.ascii",
    "color": {
      "1": "red",
      "2": "yellow"
    }
  },
  "display": {
    "separator": " ❯ "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "yellow",
        "at": "red",
        "host": "yellow"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "🏰 Reino Terrenal",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "🛡️  Núcleo de Poder",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "⏳ Tiempo de Guardia",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "🌋 Forjas Orodruin",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "🏛️  Bóvedas Barad-dûr",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "⚔️  Armería de Mordor",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "🐚 Concha de Mando",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "🖥️  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
