import math, datetime
now = datetime.datetime.now(datetime.timezone.utc)
lat, lon = 40.4168, -3.7038
n = now.timetuple().tm_yday
gamma = 2.0 * math.pi / 365.0 * (n - 1 + (now.hour - 12) / 24.0)
eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(gamma) - 0.032077 * math.sin(gamma) - 0.014615 * math.cos(2 * gamma) - 0.040849 * math.sin(2 * gamma))
decl = 0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma) - 0.006758 * math.cos(2 * gamma) + 0.000907 * math.sin(2 * gamma)
time_offset = eqtime + 4.0 * lon
tst = (now.hour * 60 + now.minute + now.second / 60.0 + time_offset) % 1440
ha = math.radians((tst / 4.0) - 180.0)
lat_r = math.radians(lat)
sza = math.acos(math.sin(lat_r) * math.sin(decl) + math.cos(lat_r) * math.cos(decl) * math.cos(ha))
elev = 90.0 - math.degrees(sza)
fase = '☀️ CENIZA DIURNA' if elev >= 10 else ('🌅 HORA DE SANGRE (Crepúsculo)' if elev >= -6 else '🌑 NOCHE DE SOMBRAS')
print(f'  • Elevación Solar Real: {elev:+.1f}° ({fase})')
