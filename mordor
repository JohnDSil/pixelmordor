#!/usr/bin/env bash
# mordor - Herramienta de línea de comandos para el tema Mordor (LOTR PixelZen)
set -euo pipefail

UUID="pixelzen@mosqui1988.github.io"
SCHEMAS="$HOME/.local/share/gnome-shell/extensions/$UUID/schemas"
SOUNDS_DIR="$HOME/.local/share/gnome-shell/extensions/$UUID/sounds"

gset() {
    gsettings --schemadir "$SCHEMAS" set org.gnome.shell.extensions.pixelzen "$@" 2>/dev/null || true
}

suena() {
    local s="$SOUNDS_DIR/$1.wav"
    if [ -f "$s" ]; then
        ( (canberra-gtk-play -f "$s" >/dev/null 2>&1 || pw-play "$s" >/dev/null 2>&1 || aplay -q "$s" >/dev/null 2>&1 || true) & ) 2>/dev/null
    fi
}

CITAS=(
    "Ash nazg durbatulûk, ash nazg gimbatul, ash nazg thrakatulûk agh burzum-ishi krimpatul. — Sauron"
    "No hay vida en el vacío... solo muerte. No puedes esconderte. ¡Te veo! — El Gran Ojo"
    "Forjado en las profundidades ardientes del Monte del Destino (Orodruin). — El Señor Oscuro"
    "¿Conoces el miedo? Se congelará tu carne y tu corazón morirá ante mi presencia. — Rey Brujo de Angmar"
    "La sombra se extiende sobre todo el mundo. La era del Hombre ha terminado. — Boca de Sauron"
    "Ni una brizna de hierba crece en la tierra marchita donde se alzan las sombras. — Tierra de las Sombras"
    "Un Anillo para gobernarlos a todos, un Anillo para encontrarlos... — Inscripción de Fuego"
)

case "${1:-info}" in
    dia)
        gset ciclo-rapido false
        gset hora-simulada 13.5
        echo -e "\033[1;33m🌋 Mordor:\033[0m Modo Ceniza Diurna activado (Cénit solar)."
        ;;
    noche)
        gset ciclo-rapido false
        gset hora-simulada 23.0
        suena sauron
        echo -e "\033[1;35m🌑 Mordor:\033[0m Modo Noche de Sombras activado."
        ;;
    sangre|dorado|ocaso)
        gset ciclo-rapido false
        gset hora-simulada 18.0
        suena anillo
        echo -e "\033[1;31m🌅 Mordor:\033[0m Modo Hora de Sangre activado (Crepúsculo carmesí)."
        ;;
    auto|real)
        gset ciclo-rapido false
        gset hora-simulada -1.0
        echo -e "\033[1;32m⏱️ Mordor:\033[0m Sincronización astronómica real activa (Algoritmo NOAA para Madrid)."
        ;;
    demo|ciclo)
        gset hora-simulada -1.0
        gset ciclo-rapido true
        echo -e "\033[1;36m⚡ Mordor:\033[0m Demostración acelerada activa (24 horas en 90 segundos)."
        ;;
    erupcion|volcan)
        suena erupcion
        echo -e "\033[1;31m🔥 ¡Super-erupción desatada en el Monte del Destino (Orodruin)!\033[0m"
        ;;
    colera|ojo|sauron)
        suena sauron
        echo -e "\033[1;31m👁 ¡La cólera del Gran Ojo se extiende sobre Barad-dûr!\033[0m"
        ;;
    nazgul|bestia)
        suena nazgul
        echo -e "\033[1;35m🦅 ¡Un Nazgûl se lanza en picado sobre las llanuras con un chillido desgarrador!\033[0m"
        ;;
    hobbits|frodo|sam)
        suena anillo
        echo -e "\033[1;33m💍 Frodo y Sam alzan el Frasco de Galadriel en las crestas de Gorgoroth.\033[0m"
        ;;
    ambiente)
        sub="${2:-toggle}"
        PID_FILE="/tmp/mordor_ambiente.pid"
        if [ "$sub" = "off" ] || ([ "$sub" = "toggle" ] && [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null); then
            if [ -f "$PID_FILE" ]; then
                kill "$(cat "$PID_FILE")" 2>/dev/null || true
                rm -f "$PID_FILE"
            fi
            echo -e "\033[1;30m🌋 Eco sísmico subterráneo detenido.\033[0m"
        else
            (
                while true; do
                    if [ -f "$SOUNDS_DIR/ambiente.wav" ]; then
                        canberra-gtk-play -f "$SOUNDS_DIR/ambiente.wav" 2>/dev/null || pw-play "$SOUNDS_DIR/ambiente.wav" 2>/dev/null || aplay -q "$SOUNDS_DIR/ambiente.wav" 2>/dev/null || true
                    fi
                    sleep 6
                done
            ) >/dev/null 2>&1 &
            echo $! > "$PID_FILE"
            echo -e "\033[1;31m🌋 Eco sísmico subterráneo continuo activado (bucle ambiental).\033[0m"
        fi
        ;;
    cita)
        idx=$(( RANDOM % ${#CITAS[@]} ))
        echo -e "\033[1;33m📜 \"${CITAS[$idx]}\"\033[0m"
        suena anillo
        ;;
    cursor)
        gsettings set org.gnome.desktop.interface cursor-theme 'MordorCursor' || true
        echo -e "\033[1;31m🗡 Cursor temático 'MordorCursor' (Daga de Morgul y Guantelete) aplicado.\033[0m"
        ;;
    hud)
        actual=$(gsettings --schemadir "$SCHEMAS" get org.gnome.shell.extensions.pixelzen hud 2>/dev/null || echo "true")
        if [ "$actual" = "true" ]; then
            gset hud false
            echo -e "\033[1;30m📊 Panel HUD oculto.\033[0m"
        else
            gset hud true
            echo -e "\033[1;32m📊 Panel HUD visible.\033[0m"
        fi
        ;;
    clima)
        CLIMA_SCRIPT="$HOME/.local/share/gnome-shell/extensions/$UUID/code/clima.py"
        if [ ! -f "$CLIMA_SCRIPT" ]; then
            CLIMA_SCRIPT="$(dirname "$0")/gnome/$UUID/code/clima.py"
        fi
        if [ -f "$CLIMA_SCRIPT" ]; then
            res=$(python3 -I "$CLIMA_SCRIPT" 2>/dev/null || echo '{"ok":false}')
            desc=$(echo "$res" | grep -oP '"desc":\s*"\K[^"]+' || echo "Atmósfera de Mordor")
            temp=$(echo "$res" | grep -oP '"temp":\s*\K-?[0-9]+' || echo "15")
            wind=$(echo "$res" | grep -oP '"wind":\s*\K[0-9]+' || echo "10")
            echo -e "\033[1;31m🌩️ Clima sincronizado en Gorgoroth / Barad-dûr:\033[0m"
            echo "  • Condición: $desc"
            echo "  • Temperatura: ${temp}°C"
            echo "  • Viento: ${wind} km/h"
        else
            echo "Script de clima no encontrado."
        fi
        ;;
    terminal)
        PTYXIS_DIR="$HOME/.local/share/org.gnome.Ptyxis/palettes"
        mkdir -p "$PTYXIS_DIR"
        PALETA_SRC="$(dirname "$0")/Mordor.palette"
        if [ -f "$PALETA_SRC" ]; then
            cp "$PALETA_SRC" "$PTYXIS_DIR/Mordor.palette"
        fi
        prof_uuid=$(gsettings get org.gnome.Ptyxis default-profile-uuid 2>/dev/null | tr -d "'" || true)
        if [ -n "$prof_uuid" ]; then
            gsettings set "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$prof_uuid/" palette 'Mordor' 2>/dev/null || true
            echo -e "\033[1;31m🎨 Paleta oficial de Mordor (rojo lava / obsidiana) aplicada al terminal Ptyxis.\033[0m"
        else
            echo "Perfil de Ptyxis no detectado, paleta instalada en $PTYXIS_DIR/Mordor.palette."
        fi
        ;;
    notif)
        suena sauron
        notify-send -a "Mordor (LOTR)" -i "$HOME/.local/share/gnome-shell/extensions/$UUID/images/escena-dorado.png" "👁 El Gran Ojo de Sauron" "¡Las sombras de Mordor se alzan! Todas las fuerzas están preparadas." 2>/dev/null || true
        echo -e "\033[1;31m🔔 Notificación de prueba de Sauron enviada al escritorio.\033[0m"
        ;;
    bloqueo)
        sub="${2:-aplicar}"
        BG_SRC="$HOME/.local/share/backgrounds/mordor-bloqueo.png"
        if [ ! -f "$BG_SRC" ]; then
            BG_SRC="$(dirname "$0")/fondos/mordor-bloqueo.png"
            mkdir -p "$HOME/.local/share/backgrounds"
            [ -f "$BG_SRC" ] && cp "$BG_SRC" "$HOME/.local/share/backgrounds/mordor-bloqueo.png"
        fi
        gsettings set org.gnome.desktop.screensaver picture-uri "file://$HOME/.local/share/backgrounds/mordor-bloqueo.png" 2>/dev/null || true
        gsettings set org.gnome.desktop.screensaver picture-options 'zoom' 2>/dev/null || true
        gsettings set org.gnome.desktop.screensaver primary-color '#050208' 2>/dev/null || true
        gsettings set org.gnome.desktop.screensaver secondary-color '#050208' 2>/dev/null || true
        echo -e "\033[1;31m🔒 Pantalla de bloqueo de Mordor (El Morannon y el Gran Ojo) configurada.\033[0m"
        if [ "$sub" = "test" ] || [ "$sub" = "lock" ]; then
            suena sauron
            sleep 0.5
            busctl --user call org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver Lock 2>/dev/null || true
        fi
        ;;
    prompt)
        sub="${2:-toggle}"
        BASHRC="$HOME/.bashrc"
        PROMPT_FILE="$HOME/.config/pixelzen/mordor_prompt.sh"
        if [ "$sub" = "off" ] || ([ "$sub" = "toggle" ] && grep -q "mordor_prompt.sh" "$BASHRC" 2>/dev/null); then
            sed -i '/mordor_prompt\.sh/d' "$BASHRC"
            echo -e "\033[1;30m🐚 Prompt de Mordor desactivado en ~/.bashrc (abrir nueva terminal para ver cambios).\033[0m"
        else
            mkdir -p "$HOME/.config/pixelzen"
            PROMPT_SRC="$(dirname "$0")/src/mordor_prompt.sh"
            [ -f "$PROMPT_SRC" ] && cp "$PROMPT_SRC" "$PROMPT_FILE"
            if ! grep -q "mordor_prompt.sh" "$BASHRC"; then
                echo '[ -f "$HOME/.config/pixelzen/mordor_prompt.sh" ] && source "$HOME/.config/pixelzen/mordor_prompt.sh"' >> "$BASHRC"
            fi
            echo -e "\033[1;31m👁 Prompt temático de Mordor (Ojo, Git reactivo y runas) activado en ~/.bashrc.\033[0m"
        fi
        ;;
    sonido|audio)
        sub="${2:-toggle}"
        cur_theme=$(gsettings get org.gnome.desktop.sound theme-name 2>/dev/null | tr -d "'" || echo "freedesktop")
        if [ "$sub" = "off" ] || ([ "$sub" = "toggle" ] && [ "$cur_theme" = "mordor" ]); then
            gsettings set org.gnome.desktop.sound theme-name 'freedesktop' 2>/dev/null || true
            echo -e "\033[1;30m🔊 Tema de sonido de Mordor desactivado (restaurado freedesktop).\033[0m"
        else
            gsettings set org.gnome.desktop.sound theme-name 'mordor' 2>/dev/null || true
            gsettings set org.gnome.desktop.sound event-sounds true 2>/dev/null || true
            gsettings set org.gnome.desktop.sound input-feedback-sounds true 2>/dev/null || true
            suena anillo
            echo -e "\033[1;31m🔊 Tema oficial de sonido XDG de Mordor activado (eventos de sistema: USB, papelera, alertas).\033[0m"
        fi
        ;;
    forjar)
        FORJAR_SCRIPT=""
        for cand in \
            "$HOME/.local/share/gnome-shell/extensions/$UUID/code/forjar.py" \
            "$HOME/.local/share/pixelzen/src/forjar.py" \
            "$(dirname "$0")/src/forjar.py" \
            "$(dirname "$0")/../src/forjar.py" \
            "$HOME/Descargas/pixelmordor/src/forjar.py" \
            "$HOME/Descargas/mordor/src/forjar.py"; do
            if [ -f "$cand" ]; then
                FORJAR_SCRIPT="$cand"
                break
            fi
        done
        if [ -n "$FORJAR_SCRIPT" ]; then
            python3 "$FORJAR_SCRIPT"
        else
            echo "Script de forja no encontrado."
        fi
        ;;
    gtk)
        sub="${2:-on}"
        GTK_SRC=""
        for cand in \
            "$HOME/.local/share/gnome-shell/extensions/$UUID/gtk/mordor-gtk.css" \
            "$HOME/.local/share/pixelzen/gtk/mordor-gtk.css" \
            "$(dirname "$0")/gnome/gtk/mordor-gtk.css" \
            "$(dirname "$0")/../gnome/gtk/mordor-gtk.css" \
            "$HOME/Descargas/pixelmordor/gnome/gtk/mordor-gtk.css" \
            "$HOME/Descargas/mordor/gnome/gtk/mordor-gtk.css"; do
            if [ -f "$cand" ]; then
                GTK_SRC="$cand"
                break
            fi
        done

        if [ "$sub" = "off" ] || [ "$sub" = "desactivar" ]; then
            rm -f "$HOME/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css"
            [ -f "$HOME/.config/gtk-4.0/gtk.css.bak" ] && mv "$HOME/.config/gtk-4.0/gtk.css.bak" "$HOME/.config/gtk-4.0/gtk.css"
            [ -f "$HOME/.config/gtk-3.0/gtk.css.bak" ] && mv "$HOME/.config/gtk-3.0/gtk.css.bak" "$HOME/.config/gtk-3.0/gtk.css"
            gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
            gsettings reset org.gnome.desktop.interface gtk-theme 2>/dev/null || true
            gsettings reset org.gnome.desktop.interface accent-color 2>/dev/null || true
            echo -e "\033[1;30m🎨 Tema GTK/Libadwaita de Mordor desactivado (restaurado tema estándar).\033[0m"
        elif [ "$sub" = "estado" ]; then
            if [ -f "$HOME/.config/gtk-4.0/gtk.css" ] && grep -q "PixelMordor" "$HOME/.config/gtk-4.0/gtk.css" 2>/dev/null; then
                echo -e "\033[1;32m🎨 Tema GTK/Libadwaita de Mordor está ACTIVO (~/.config/gtk-4.0/gtk.css)\033[0m"
            else
                echo -e "\033[1;30m🎨 Tema GTK/Libadwaita de Mordor está INACTIVO\033[0m"
            fi
        else
            if [ -z "$GTK_SRC" ]; then
                echo -e "\033[1;31mError:\033[0m Archivo mordor-gtk.css no encontrado."
            else
                mkdir -p "$HOME/.config/gtk-4.0" "$HOME/.config/gtk-3.0"
                if [ -f "$HOME/.config/gtk-4.0/gtk.css" ] && ! grep -q "PixelMordor" "$HOME/.config/gtk-4.0/gtk.css" 2>/dev/null; then
                    cp "$HOME/.config/gtk-4.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css.bak"
                fi
                if [ -f "$HOME/.config/gtk-3.0/gtk.css" ] && ! grep -q "PixelMordor" "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null; then
                    cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-3.0/gtk.css.bak"
                fi
                cp "$GTK_SRC" "$HOME/.config/gtk-4.0/gtk.css"
                cp "$GTK_SRC" "$HOME/.config/gtk-3.0/gtk.css"
                gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface accent-color 'red' 2>/dev/null || true
                suena anillo
                echo -e "\033[1;31m🎨 Tema GTK4/Libadwaita y GTK3 de Mordor activado con éxito.\033[0m"
                echo -e "   • Ventanas obsidiana (#0d0308) con acentos volcánicos carmesí (#ef4444)"
                echo -e "   • Scrollbars con aspecto de magma y botones sugeridos en gradiente ardiente"
                echo -e "   • Compatible con todas las aplicaciones GNOME (Archivos, Ptyxis, Ajustes, etc.)"
            fi
        fi
        ;;
    atajos|keys)
        sub="${2:-on}"
        python3 -c "
import sys
from gi.repository import Gio

mordor_keys = [
    ('mordor-erupcion', 'Mordor: Erupción del Monte del Destino', 'mordor erupcion', '<Super><Alt>e'),
    ('mordor-colera', 'Mordor: Cólera del Ojo de Sauron', 'mordor colera', '<Super><Alt>s'),
    ('mordor-nazgul', 'Mordor: Ataque del Nazgûl', 'mordor nazgul', '<Super><Alt>n'),
    ('mordor-bloqueo', 'Mordor: Bloqueo de Pantalla (El Morannon)', 'mordor bloqueo lock', '<Super><Alt>b'),
    ('mordor-forjar', 'Mordor: Forja del Anillo Único', 'ptyxis --new-window -- mordor forjar', '<Super><Alt>f'),
]

settings = Gio.Settings(schema='org.gnome.settings-daemon.plugins.media-keys')
current = list(settings.get_strv('custom-keybindings'))
sub = '$sub'

if sub in ('off', 'desactivar', 'clear'):
    updated = [p for p in current if '/mordor-' not in p]
    settings.set_strv('custom-keybindings', updated)
    print('\033[1;30m⌨️ Atajos de teclado globales de Mordor desactivados.\033[0m')
elif sub in ('estado', 'status', 'listar'):
    mordor_active = [p for p in current if '/mordor-' in p]
    if mordor_active:
        print('\033[1;32m⌨️ Atajos de teclado globales de Mordor ACTIVOS:\033[0m')
        for key_id, name, cmd, bind in mordor_keys:
            path = f'/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/{key_id}/'
            if path in mordor_active:
                s = Gio.Settings(schema='org.gnome.settings-daemon.plugins.media-keys.custom-keybinding', path=path)
                print(f'   • \033[1;33m{s.get_string(\"binding\")}\033[0m -> {name} (\033[1;31m{s.get_string(\"command\")}\033[0m)')
    else:
        print('\033[1;30m⌨️ Atajos de teclado globales de Mordor INACTIVOS\033[0m')
else:
    paths = [f'/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/{k[0]}/' for k in mordor_keys]
    for key_id, name, cmd, bind in mordor_keys:
        path = f'/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/{key_id}/'
        s = Gio.Settings(schema='org.gnome.settings-daemon.plugins.media-keys.custom-keybinding', path=path)
        s.set_string('name', name)
        s.set_string('command', cmd)
        s.set_string('binding', bind)
    updated = [p for p in current if '/mordor-' not in p] + paths
    settings.set_strv('custom-keybindings', updated)
    print('\033[1;31m⌨️ Atajos de teclado globales de GNOME activados para Mordor:\033[0m')
    print('   • \033[1;33mSuper + Alt + E\033[0m -> Super-erupción en el Orodruin')
    print('   • \033[1;33mSuper + Alt + S\033[0m -> Cólera del Ojo de Sauron')
    print('   • \033[1;33mSuper + Alt + N\033[0m -> Chillido y ataque en picado del Nazgûl')
    print('   • \033[1;33mSuper + Alt + B\033[0m -> Bloquear pantalla en El Morannon')
    print('   • \033[1;33mSuper + Alt + F\033[0m -> Forja interactiva del Anillo Único (Ptyxis)')
"
        ;;
    grub)
        sub="${2:-estado}"
        GRUB_SCRIPT=""
        for cand in \
            "$(dirname "$0")/grub/instalar_grub.sh" \
            "$(dirname "$0")/../grub/instalar_grub.sh" \
            "$HOME/Descargas/pixelmordor/grub/instalar_grub.sh" \
            "$HOME/Descargas/mordor/grub/instalar_grub.sh"; do
            if [ -f "$cand" ]; then
                GRUB_SCRIPT="$cand"
                break
            fi
        done

        if [ "$sub" = "on" ] || [ "$sub" = "install" ] || [ "$sub" = "activar" ]; then
            if [ -n "$GRUB_SCRIPT" ]; then
                echo -e "\033[1;33m==> Instalando tema de arranque GRUB 2 de Mordor (requiere sudo)...\033[0m"
                sudo "$GRUB_SCRIPT"
            else
                echo -e "\033[1;31mError:\033[0m Script instalar_grub.sh no encontrado."
            fi
        elif [ "$sub" = "off" ] || [ "$sub" = "remove" ] || [ "$sub" = "desactivar" ]; then
            DES_GRUB="$(dirname "$GRUB_SCRIPT")/desinstalar_grub.sh"
            if [ -f "$DES_GRUB" ]; then
                echo -e "\033[1;33m==> Desinstalando tema GRUB 2 de Mordor (requiere sudo)...\033[0m"
                sudo "$DES_GRUB"
            else
                sudo sed -i '/^GRUB_THEME=/d' /etc/default/grub && sudo update-grub
            fi
        else
            echo -e "\033[1;31m═══════════════════════════════════════════════════════════\033[0m"
            echo -e "\033[1;37m        TEMA DE ARRANQUE GRUB 2 · TIERRA DE MORDOR         \033[0m"
            echo -e "\033[1;31m═══════════════════════════════════════════════════════════\033[0m"
            if grep -q "themes/mordor" /etc/default/grub 2>/dev/null; then
                echo -e "  • Estado: \033[1;32mACTIVO (/boot/grub/themes/mordor)\033[0m"
            else
                echo -e "  • Estado: \033[1;30mINACTIVO\033[0m"
            fi
            echo "  • Fondo: El Morannon & Barad-dûr (1920x1080 Full HD)"
            echo "  • Fuentes: Tipografía rúnica Departure Mono (16px y 24px en .pf2)"
            echo "  • Selector: Marco obsidiana con resplandor de lava y magma"
            echo "  • Uso:"
            echo "      mordor grub on   -> Instalar tema en /boot/grub/themes y activar"
            echo "      mordor grub off  -> Desactivar y restaurar GRUB por defecto"
            echo -e "\033[1;31m═══════════════════════════════════════════════════════════\033[0m"
        fi
        ;;
    resolucion|fondo)
        sub="${2:-auto}"
        FONDOS_PATH=""
        for cand in \
            "$(dirname "$0")/fondos" \
            "$(dirname "$0")/../fondos" \
            "$HOME/Descargas/pixelmordor/fondos" \
            "$HOME/Descargas/mordor/fondos"; do
            if [ -d "$cand" ]; then
                FONDOS_PATH="$cand"
                break
            fi
        done

        if [ "$sub" = "compilar" ]; then
            python3 "$HOME/Descargas/pixelmordor/src/construir_resoluciones.py"
        else
            # Determinar resolucion
            TARGET_RES="$sub"
            if [ "$sub" = "auto" ]; then
                # Intentar detectar resolucion activa
                det_w=$(xrandr 2>/dev/null | grep '\*' | awk '{print $1}' | cut -d'x' -f1 | head -n1 || echo "")
                if [ -z "$det_w" ]; then
                    det_w=1920
                fi
                if [ "$det_w" -ge 3400 ]; then
                    TARGET_RES="ultrawide"
                elif [ "$det_w" -ge 3800 ]; then
                    TARGET_RES="4k"
                elif [ "$det_w" -ge 2500 ]; then
                    TARGET_RES="2k"
                else
                    TARGET_RES="1080p"
                fi
            fi

            # Buscar fondo de noche o dia
            f_cand="$FONDOS_PATH/mordor-noche-${TARGET_RES}.png"
            if [ ! -f "$f_cand" ]; then
                f_cand="$FONDOS_PATH/mordor-noche.png"
            fi

            mkdir -p "$HOME/.local/share/backgrounds"
            cp "$f_cand" "$HOME/.local/share/backgrounds/mordor.png"
            URI="file://$HOME/.local/share/backgrounds/mordor.png"
            gsettings set org.gnome.desktop.background picture-uri "$URI" 2>/dev/null || true
            gsettings set org.gnome.desktop.background picture-uri-dark "$URI" 2>/dev/null || true
            echo -e "\033[1;32m🖼️ Fondo de pantalla adaptado a resolución [$TARGET_RES] aplicado con éxito.\033[0m"
            echo "   Archivo: $f_cand"
        fi
        ;;
    motd)
        sub="${2:-probar}"
        MOTD_SH="$HOME/.config/pixelzen/mordor_motd.sh"
        [ -f "$MOTD_SH" ] || MOTD_SH="$(dirname "$0")/src/mordor_motd.sh"
        [ -f "$MOTD_SH" ] || MOTD_SH="$HOME/Descargas/pixelmordor/src/mordor_motd.sh"

